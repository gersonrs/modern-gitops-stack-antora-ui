          <circle cx="19" cy="46.5" r="11" fill="url(#mgNavPipeGrad)" stroke="#0a192f" stroke-width="1.5"/>
          <circle cx="19" cy="46.5" r="5.2" fill="#0a192f"/>
          <circle cx="19" cy="38.3" r="0.9" fill="#0a192f"/>
          <circle cx="24.8" cy="40.7" r="0.9" fill="#0a192f"/>
