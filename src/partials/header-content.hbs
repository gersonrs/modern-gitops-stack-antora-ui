          <circle cx="19" cy="54.7" r="0.9" fill="#0a192f"/>
          <circle cx="13.2" cy="52.3" r="0.9" fill="#0a192f"/>
          <circle cx="10.8" cy="46.5" r="0.9" fill="#0a192f"/>
          <circle cx="13.2" cy="40.7" r="0.9" fill="#0a192f"/>
        </svg>
        <span class="mg-nav-wordmark">
          <span class="mg-nav-title">MODERN <span class="mg-nav-accent">GITOPS</span></span>
          <span class="mg-nav-sub">STACK</span>
        </span>
        <span class="mg-nav-badge">DOCS</span>
      </a>

      {{#if env.SITE_SEARCH_PROVIDER}}
      <div class="navbar-item search hide-for-print">
        <div id="search-field" class="field mg-search-box">
          <svg class="mg-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input id="search-input" type="text" placeholder="Buscar na documentação..." aria-label="Buscar na documentação"{{#if page.home}} autofocus{{/if}}>
          <kbd class="mg-search-kbd" aria-hidden="true">/</kbd>
        </div>
      </div>
      {{/if}}

      <button class="navbar-burger" type="button" data-target="topbar-nav" aria-label="Abrir menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        <a class="navbar-item mg-nav-link" href="https://github.com/GersonRS/modern-gitops-stack" target="_blank" rel="noopener noreferrer">
